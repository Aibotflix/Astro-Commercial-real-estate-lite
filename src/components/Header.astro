---
import { site } from '../data/site'
import DarkModeToggle from './DarkModeToggle.astro'
---

<header class="sticky top-0 z-50 bg-canvas/90 backdrop-blur border-b border-border">
  <nav class="max-w-6xl mx-auto px-4 h-16 flex items-center justify-between">
    <a href="/" class="text-xl font-bold text-accent no-underline">{site.name}</a>
    <div class="flex items-center gap-2">
      <ul class="hidden md:flex items-center gap-6 list-none m-0 p-0">
        <li><a href="/" class="text-sm font-medium text-muted hover:text-accent no-underline transition-colors">Home</a></li>
        <li><a href="/listings/" class="text-sm font-medium text-muted hover:text-accent no-underline transition-colors">Listings</a></li>
        <li><a href="/about/" class="text-sm font-medium text-muted hover:text-accent no-underline transition-colors">About</a></li>
        <li><a href="/contact/" class="text-sm font-medium text-muted hover:text-accent no-underline transition-colors">Contact</a></li>
      </ul>
      <DarkModeToggle />
    </div>
  </nav>
</header>

<nav class="fixed bottom-0 left-0 right-0 z-50 bg-canvas/95 backdrop-blur border-t border-border flex md:hidden justify-around items-center h-16 safe-area-bottom">
  <a href="/" class="flex flex-col items-center gap-0.5 text-muted hover:text-accent no-underline transition-colors text-[10px] font-medium">
    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" /></svg>
    <span>Home</span>
  </a>
  <a href="/listings/" class="flex flex-col items-center gap-0.5 text-muted hover:text-accent no-underline transition-colors text-[10px] font-medium">
    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z" /></svg>
    <span>Listings</span>
  </a>
  <a href="/about/" class="flex flex-col items-center gap-0.5 text-muted hover:text-accent no-underline transition-colors text-[10px] font-medium">
    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z" /></svg>
    <span>About</span>
  </a>
  <a href="/contact/" class="flex flex-col items-center gap-0.5 text-muted hover:text-accent no-underline transition-colors text-[10px] font-medium">
    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" /></svg>
    <span>Contact</span>
  </a>
</nav>
