---
import BaseLayout from '../layouts/BaseLayout.astro'
import AgentCard from '../components/AgentCard.astro'
import { site, agents } from '../data/site'
---

<BaseLayout title="About" description="Learn about {site.name} and meet our team of commercial real estate experts.">
  <section class="max-w-6xl mx-auto px-4 pt-8 pb-16">
    <h1 class="text-3xl font-extrabold mb-4">About Us</h1>
    <p class="text-muted max-w-3xl mb-12">
      {site.name} has been connecting businesses with the perfect commercial spaces since 2010.
      Our team brings deep market knowledge and a commitment to results across office, retail,
      industrial, and land transactions.
    </p>

    <h2 class="text-2xl font-bold mb-6">Our Team</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {agents.map((a) => <AgentCard {...a} />)}
    </div>
  </section>
</BaseLayout>
