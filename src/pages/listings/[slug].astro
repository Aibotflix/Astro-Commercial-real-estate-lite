---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { site, listings } from '../../data/site'

export function getStaticPaths() {
  return listings.map((l) => ({
    params: { slug: l.slug },
    props: { listing: l },
  }))
}

const { listing } = Astro.props
const inquireHref = `/contact/?property=${encodeURIComponent(listing.title)}`
---

<BaseLayout title={listing.title} description={listing.description} image={listing.image}>
  <section class="max-w-4xl mx-auto px-4 py-16">
    <a href="/listings/" class="inline-flex items-center gap-1 text-sm text-muted hover:text-accent no-underline mb-8 transition-colors">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" /></svg>
      Back to Listings
    </a>

    <div class="aspect-[16/9] rounded-2xl overflow-hidden bg-border mb-8">
      <img src={listing.image} alt={listing.title} class="w-full h-full object-cover" />
    </div>

    <div class="mb-6">
      <span class="inline-block text-xs font-semibold uppercase tracking-wider text-accent mb-2">{listing.type}</span>
      <h1 class="text-3xl md:text-4xl font-extrabold mb-2">{listing.title}</h1>
      <p class="text-muted">{listing.address}</p>
    </div>

    <div class="flex items-center justify-between py-6 border-y border-border mb-6">
      <div>
        <p class="text-sm text-muted">Square Footage</p>
        <p class="text-xl font-bold">{listing.sqft} sq ft</p>
      </div>
      <div class="text-right">
        <p class="text-sm text-muted">Price</p>
        <p class="text-2xl font-bold text-accent">{listing.price}</p>
      </div>
    </div>

    <div class="mb-8">
      <h2 class="text-lg font-bold mb-3">Description</h2>
      <p class="text-muted leading-relaxed">{listing.description}</p>
    </div>

    <a href={inquireHref} class="inline-block bg-accent hover:brightness-90 text-white font-semibold px-8 py-3.5 rounded-xl transition-all no-underline">Inquire About This Property</a>
  </section>
</BaseLayout>
