---
import BaseLayout from '../layouts/BaseLayout.astro'
import ListingCard from '../components/ListingCard.astro'
import { site, listings } from '../data/site'
import stats from '../data/stats.json'

const featured = listings.slice(0, 3)
const typeNames = [...new Set(listings.map(l => l.type))]
const types = typeNames.map(name => ({
  name,
  count: listings.filter(l => l.type === name).length,
  href: '/listings/?type=' + encodeURIComponent(name),
}))
---

<BaseLayout>
  <section class="max-w-6xl mx-auto px-4 pt-8 pb-16 grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
    <div>
      <h1 class="text-5xl md:text-7xl font-extrabold leading-[1.05] tracking-tight mb-6">
        <span class="bg-gradient-to-r from-accent to-purple-500 bg-clip-text text-transparent">
          {site.tagline}
        </span>
      </h1>
      <p class="text-lg text-muted max-w-xl mb-10 leading-relaxed">
        {site.description}
      </p>
      <a
        href="/listings/"
        class="inline-block bg-accent hover:brightness-90 text-white font-semibold px-8 py-3.5 rounded-xl transition-all no-underline"
      >Browse Properties</a>

      <div class="flex flex-wrap gap-x-12 gap-y-4 mt-12 pt-12 border-t border-border">
        {stats.map((s) => (
          <div>
            <p class="text-3xl font-extrabold text-accent">{s.value}</p>
            <p class="text-sm text-muted">{s.label}</p>
          </div>
        ))}
      </div>
    </div>

    <div class="relative">
      <div class="aspect-[4/5] rounded-2xl overflow-hidden bg-border">
        <img
          src="https://images.unsplash.com/photo-1477959858617-67f85cf4f1df?w=800&h=1000&fit=crop"
          alt="City skyline"
          class="w-full h-full object-cover"
          fetchpriority="high"
        />
      </div>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-4 pb-24">
    <div class="flex items-center gap-4 mb-8">
      <h2 class="text-xl font-bold">Browse by type</h2>
      <div class="flex-1 h-px bg-border"></div>
    </div>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      {types.map((t) => (
        <a
          href={t.href}
          class="group rounded-2xl border border-border bg-surface p-6 hover:shadow-lg transition-all no-underline hover:-translate-y-0.5"
        >
          <div class="text-3xl mb-3">
            {t.name === 'Office' && <svg class="w-8 h-8 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 21h16.5M4.5 3h15M5.25 3v18m13.5-18v18M9 6.75h1.5m-1.5 3h1.5m-1.5 3h1.5m3-6H15m-1.5 3H15m-1.5 3H15M9 21v-3.375c0-.621.504-1.125 1.125-1.125h3.75c.621 0 1.125.504 1.125 1.125V21" /></svg>}
            {t.name === 'Retail' && <svg class="w-8 h-8 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 21v-7.5a.75.75 0 01.75-.75h3a.75.75 0 01.75.75V21m-4.5 0H2.36m11.14 0H18m0 0h3.64m-1.39 0V9.349m-16.5 11.65V9.35m0 0a3.001 3.001 0 003.75-.615A2.993 2.993 0 009.75 9.75c.896 0 1.7-.393 2.25-1.016a2.993 2.993 0 002.25 1.016c.896 0 1.7-.393 2.25-1.016a3.001 3.001 0 003.75.614m-16.5 0a3.004 3.004 0 01-.621-4.72L4.318 3.44A1.5 1.5 0 015.378 3h13.243a1.5 1.5 0 011.06.44l1.19 1.189a3 3 0 01-.621 4.72m-13.5 8.65h3.75a.75.75 0 00.75-.75V13.5a.75.75 0 00-.75-.75H6.75a.75.75 0 00-.75.75v3.75c0 .415.336.75.75.75z" /></svg>}
            {t.name === 'Industrial' && <svg class="w-8 h-8 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 00-10.026 0 1.106 1.106 0 00-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12" /></svg>}
            {t.name === 'Land' && <svg class="w-8 h-8 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 21L19.5 3.75 21 5.25 4.5 21H2.25zM2.25 21L17.25 6M2.25 21h16.5l-6-6" /></svg>}
          </div>
          <h3 class="font-bold text-ink text-lg">{t.name}</h3>
          <p class="text-sm text-muted">{t.count} {t.count === 1 ? 'property' : 'properties'}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-4 py-24 reveal">
    <div class="flex items-center gap-4 mb-10">
      <h2 class="text-3xl font-bold">Featured Properties</h2>
      <div class="flex-1 h-px bg-border"></div>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {featured.map((l) => <ListingCard {...l} />)}
    </div>
  </section>

  <section class="bg-surface py-24 reveal">
    <div class="max-w-6xl mx-auto px-4 text-center">
      <h2 class="text-3xl font-bold mb-4">Ready to find your next property?</h2>
      <p class="text-muted mb-8 max-w-md mx-auto">Get in touch with our team today.</p>
      <a
        href="/contact/"
        class="inline-block bg-accent hover:brightness-90 text-white font-semibold px-10 py-4 rounded-xl transition-all no-underline"
      >Contact Us</a>
    </div>
  </section>
</BaseLayout>
